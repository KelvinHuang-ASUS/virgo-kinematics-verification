<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Include vendor CAD transformation properties -->
  <xacro:include filename="virgo_cad_transforms.xacro" />

  <xacro:macro name="virgo_gimbal">
    
    <!-- =================================================================== -->
    <!-- 13 Kinematic Links (Internal Standard Nomenclature & OpenCV Frames) -->
    <!-- =================================================================== -->
    
    <!-- 1. ISP Box Mount Link (Kinematic Root Base) -->
    <link name="gimbal_mnt_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.08 0.08 0.04" />
        </geometry>
      </visual>
    </link>

    <!-- 2. Suspension Dampening Plate Link -->
    <link name="gimbal_susp_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.07 0.07 0.02" />
        </geometry>
      </visual>
    </link>

    <!-- 3. Roll Axis Motor Link (Motor 3) -->
    <link name="gimbal_motor_3_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.02" length="0.04" />
        </geometry>
      </visual>
    </link>

    <!-- 4. Yaw Axis Motor Link (Motor 2) -->
    <link name="gimbal_motor_2_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.02" length="0.04" />
        </geometry>
      </visual>
    </link>

    <!-- 5. Pitch Axis Motor Link (Motor 1) -->
    <link name="gimbal_motor_1_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.02" length="0.04" />
        </geometry>
      </visual>
    </link>

    <!-- 6. Sensor Payload Bracket Link -->
    <link name="gimbal_payload_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.10 0.06 0.05" />
        </geometry>
      </visual>
    </link>

    <!-- 7. IMU Sensor Link Frame -->
    <link name="imu_1_frame">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.015 0.015 0.008" />
        </geometry>
      </visual>
    </link>

    <!-- 8. Narrow Camera Sensor Link -->
    <link name="cam_narrow_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.012" length="0.025" />
        </geometry>
      </visual>
    </link>

    <!-- 9. Telephoto Camera Sensor Link -->
    <link name="cam_tele_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.015" length="0.035" />
        </geometry>
      </visual>
    </link>

    <!-- 10. Wide Camera Sensor Link -->
    <link name="cam_wide_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.010" length="0.020" />
        </geometry>
      </visual>
    </link>

    <!-- 11. Narrow Camera OpenCV Visual Frame Link -->
    <link name="cam_narrow_cv_frame" />

    <!-- 12. Telephoto Camera OpenCV Visual Frame Link -->
    <link name="cam_tele_cv_frame" />

    <!-- 13. Wide Camera OpenCV Visual Frame Link -->
    <link name="cam_wide_cv_frame" />

    <!-- =================================================================== -->
    <!-- 12 Kinematic Transformation Joints (Internal Standard Nomenclature) -->
    <!-- Topology: Mount -> Suspension -> Motor 3 (Roll) -> Motor 2 (Yaw) -> -->
    <!--           Motor 1 (Pitch) -> Payload -> (IMU / Narrow / Tele / Wide)-->
    <!--           -> (Narrow_CV / Tele_CV / Wide_CV)                        -->
    <!-- =================================================================== -->

    <!-- Joint 1: Mount Base to Suspension (Fixed) -->
    <joint name="gimbal_mnt_to_susp_joint" type="fixed">
      <parent link="gimbal_mnt_link" />
      <child link="gimbal_susp_link" />
      <origin xyz="${isp_box_to_suspend_xyz}" rpy="${isp_box_to_suspend_rpy}" />
    </joint>

    <!-- Joint 2: Suspension to Motor 3 / Roll Axis (Revolute) -->
    <joint name="gimbal_susp_to_motor3_joint" type="revolute">
      <parent link="gimbal_susp_link" />
      <child link="gimbal_motor_3_link" />
      <origin xyz="${suspend_to_roll_xyz}" rpy="${suspend_to_roll_rpy}" />
      <axis xyz="1 0 0" />
      <limit lower="-0.785398" upper="0.785398" effort="10.0" velocity="1.0" />
    </joint>

    <!-- Joint 3: Motor 3 to Motor 2 / Yaw Axis (Revolute) -->
    <joint name="gimbal_motor3_to_motor2_joint" type="revolute">
      <parent link="gimbal_motor_3_link" />
      <child link="gimbal_motor_2_link" />
      <origin xyz="${roll_to_yaw_xyz}" rpy="${roll_to_yaw_rpy}" />
      <axis xyz="0 0 1" />
      <limit lower="-2.79253" upper="2.79253" effort="10.0" velocity="1.0" />
    </joint>

    <!-- Joint 4: Motor 2 to Motor 1 / Pitch Axis (Revolute) -->
    <joint name="gimbal_motor2_to_motor1_joint" type="revolute">
      <parent link="gimbal_motor_2_link" />
      <child link="gimbal_motor_1_link" />
      <origin xyz="${yaw_to_pitch_xyz}" rpy="${yaw_to_pitch_rpy}" />
      <axis xyz="0 1 0" />
      <limit lower="-1.5708" upper="0.785398" effort="10.0" velocity="1.0" />
    </joint>

    <!-- Joint 5: Motor 1 to Payload Bracket (Fixed) -->
    <joint name="gimbal_motor1_to_payload_joint" type="fixed">
      <parent link="gimbal_motor_1_link" />
      <child link="gimbal_payload_link" />
      <origin xyz="${pitch_to_payload_xyz}" rpy="${pitch_to_payload_rpy}" />
    </joint>

    <!-- Joint 6: Payload to IMU (Fixed) -->
    <joint name="gimbal_payload_to_imu_joint" type="fixed">
      <parent link="gimbal_payload_link" />
      <child link="imu_1_frame" />
      <origin xyz="${payload_to_imu_xyz}" rpy="${payload_to_imu_rpy}" />
    </joint>

    <!-- Joint 7: Payload to Narrow Camera (Fixed) -->
    <joint name="gimbal_payload_to_narrow_joint" type="fixed">
      <parent link="gimbal_payload_link" />
      <child link="cam_narrow_link" />
      <origin xyz="${payload_to_narrow_xyz}" rpy="${payload_to_narrow_rpy}" />
    </joint>

    <!-- Joint 8: Payload to Tele Camera (Fixed) -->
    <joint name="gimbal_payload_to_tele_joint" type="fixed">
      <parent link="gimbal_payload_link" />
      <child link="cam_tele_link" />
      <origin xyz="${payload_to_tele_xyz}" rpy="${payload_to_tele_rpy}" />
    </joint>

    <!-- Joint 9: Payload to Wide Camera (Fixed) -->
    <joint name="gimbal_payload_to_wide_joint" type="fixed">
      <parent link="gimbal_payload_link" />
      <child link="cam_wide_link" />
      <origin xyz="${payload_to_wide_xyz}" rpy="${payload_to_wide_rpy}" />
    </joint>

    <!-- Joint 10: Narrow Camera Link to OpenCV Visual Frame (Fixed) -->
    <joint name="cam_narrow_cv_j" type="fixed">
      <parent link="cam_narrow_link" />
      <child link="cam_narrow_cv_frame" />
      <origin xyz="${cam_link_to_cv_xyz}" rpy="${cam_link_to_cv_rpy}" />
    </joint>

    <!-- Joint 11: Tele Camera Link to OpenCV Visual Frame (Fixed) -->
    <joint name="cam_tele_cv_j" type="fixed">
      <parent link="cam_tele_link" />
      <child link="cam_tele_cv_frame" />
      <origin xyz="${cam_link_to_cv_xyz}" rpy="${cam_link_to_cv_rpy}" />
    </joint>

    <!-- Joint 12: Wide Camera Link to OpenCV Visual Frame (Fixed) -->
    <joint name="cam_wide_cv_j" type="fixed">
      <parent link="cam_wide_link" />
      <child link="cam_wide_cv_frame" />
      <origin xyz="${cam_link_to_cv_xyz}" rpy="${cam_link_to_cv_rpy}" />
    </joint>

  </xacro:macro>

</robot>
