<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- =================================================================== -->
  <!-- Standard Rigid Body Inertia Calculation Macros                      -->
  <!-- =================================================================== -->

  <!-- Solid Box Inertia Tensor Calculation Macro -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia 
      ixx="${(1.0/12.0) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
      iyy="${(1.0/12.0) * mass * (x*x + z*z)}" iyz="0.0"
      izz="${(1.0/12.0) * mass * (x*x + y*y)}" />
  </xacro:macro>

  <!-- Solid Box Full Inertial Block Macro -->
  <xacro:macro name="box_inertial" params="mass x y z xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />
      <xacro:box_inertia mass="${mass}" x="${x}" y="${y}" z="${z}" />
    </inertial>
  </xacro:macro>

  <!-- Solid Cylinder Inertia Tensor Calculation Macro (aligned along Z axis) -->
  <xacro:macro name="cylinder_inertia" params="mass r l">
    <inertia 
      ixx="${(1.0/12.0) * mass * (3*r*r + l*l)}" ixy="0.0" ixz="0.0"
      iyy="${(1.0/12.0) * mass * (3*r*r + l*l)}" iyz="0.0"
      izz="${(1.0/2.0) * mass * r*r}" />
  </xacro:macro>

  <!-- Solid Cylinder Full Inertial Block Macro -->
  <xacro:macro name="cylinder_inertial" params="mass r l xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />
      <xacro:cylinder_inertia mass="${mass}" r="${r}" l="${l}" />
    </inertial>
  </xacro:macro>

  <!-- Solid Sphere Inertia Tensor Calculation Macro -->
  <xacro:macro name="sphere_inertia" params="mass r">
    <inertia 
      ixx="${(2.0/5.0) * mass * r*r}" ixy="0.0" ixz="0.0"
      iyy="${(2.0/5.0) * mass * r*r}" iyz="0.0"
      izz="${(2.0/5.0) * mass * r*r}" />
  </xacro:macro>

  <!-- Solid Sphere Full Inertial Block Macro -->
  <xacro:macro name="sphere_inertial" params="mass r xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />
      <xacro:sphere_inertia mass="${mass}" r="${r}" />
    </inertial>
  </xacro:macro>

</robot>
