digraph G {
  rankdir=TB;
  node [fontname="Helvetica", fontsize=10, shape=box, style="filled,rounded"];
  edge [fontname="Helvetica", fontsize=9];

  "gimbal_mnt_link" [fillcolor="#FEF3C7", color="#D97706", label="gimbal_mnt_link"];
  "gimbal_susp_link" [fillcolor="#F8FAFC", color="#334155", label="gimbal_susp_link"];
  "gimbal_motor_3_link" [fillcolor="#F8FAFC", color="#334155", label="gimbal_motor_3_link"];
  "gimbal_motor_2_link" [fillcolor="#F8FAFC", color="#334155", label="gimbal_motor_2_link"];
  "gimbal_motor_1_link" [fillcolor="#F8FAFC", color="#334155", label="gimbal_motor_1_link"];
  "gimbal_payload_link" [fillcolor="#F8FAFC", color="#334155", label="gimbal_payload_link"];
  "imu_1_frame" [fillcolor="#F8FAFC", color="#334155", label="imu_1_frame"];
  "cam_narrow_link" [fillcolor="#F8FAFC", color="#334155", label="cam_narrow_link"];
  "cam_tele_link" [fillcolor="#F8FAFC", color="#334155", label="cam_tele_link"];
  "cam_wide_link" [fillcolor="#F8FAFC", color="#334155", label="cam_wide_link"];

  "gimbal_mnt_link" -> "gimbal_susp_link" [label="gimbal_mnt_to_susp_joint\n[fixed]", style="dashed", color="#475569"];
  "gimbal_susp_link" -> "gimbal_motor_3_link" [label="gimbal_susp_to_motor3_joint\n[revolute]", color="#0284C7", style="bold"];
  "gimbal_motor_3_link" -> "gimbal_motor_2_link" [label="gimbal_motor3_to_motor2_joint\n[revolute]", color="#0284C7", style="bold"];
  "gimbal_motor_2_link" -> "gimbal_motor_1_link" [label="gimbal_motor2_to_motor1_joint\n[revolute]", color="#0284C7", style="bold"];
  "gimbal_motor_1_link" -> "gimbal_payload_link" [label="gimbal_motor1_to_payload_joint\n[fixed]", style="dashed", color="#475569"];
  "gimbal_payload_link" -> "imu_1_frame" [label="gimbal_payload_to_imu_joint\n[fixed]", style="dashed", color="#475569"];
  "gimbal_payload_link" -> "cam_narrow_link" [label="gimbal_payload_to_narrow_joint\n[fixed]", style="dashed", color="#475569"];
  "gimbal_payload_link" -> "cam_tele_link" [label="gimbal_payload_to_tele_joint\n[fixed]", style="dashed", color="#475569"];
  "gimbal_payload_link" -> "cam_wide_link" [label="gimbal_payload_to_wide_joint\n[fixed]", style="dashed", color="#475569"];
}
