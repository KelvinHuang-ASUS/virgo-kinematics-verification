  "gimbal_motor_2_link" -> "gimbal_motor_1_link" [label="j_gimbal_motor_1\n[continuous]", color="#0284C7", style="bold"];
  "gimbal_mnt_link" -> "gimbal_amba_bd_link" [label="j_gimbal_amba_bd\n[fixed]", style="dashed", color="#475569"];
