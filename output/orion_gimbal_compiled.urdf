  <link name="cam_wide_link">
    <crs:description>
      <crs:name>Camera Link</crs:name>
      <crs:purpose>
          Camera link where x axis is aligned with the camera's forward direction, i.e. optical axis. This is necessary for compliance with widely used robotics conventions and CAD software.
        </crs:purpose>
      <crs:authority>Pegasus DIT</crs:authority>
      <crs:origin>
          The geometric center of the physical image sensor grid (focal plane).
          TBD: Alternatively, the center of the aperture could be used or the "virtual" pinhole of the camera-lens system.
        </crs:origin>
      <crs:orientation>
          X: Forward:
            The optical axis, pointing straight out of the lens, perpendicular to the image sensor plane.
          Z: Down:
            In-sensor-plane axis aligned with increasing row index (top-to-bottom in the image). For rolling shutter, this is the same direction as the line-sweep/readout progression. For global shutter, use the line readout order (first read row to later read rows) to define the +Z direction.
          Y: Right:
            In-sensor-plane axis aligned with increasing column index within a row.
        </crs:orientation>
    </crs:description>
    <visual>
      <origin rpy="0 1.5708 0" xyz="0.005 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.008"/>
      </geometry>
      <material name="lens_blue"/>
    </visual>
  </link>
  <joint name="cam_wide_j" type="fixed">
    <parent link="gimbal_amba_bd_link"/>
    <child link="cam_wide_link"/>
    <origin rpy="0 0 0" xyz="0.03 0.02 0"/>
  </joint>
  <link name="cam_wide_cv_frame">
    <crs:description>
      <crs:name>Camera Computer Vision Frame</crs:name>
      <crs:purpose>
          Camera computer vision frame compliant with computer vision conventions where Z axis is parallel to the optical axis and designates the image depth. Note that depending on the ISP configuration, the lines in the image sensor's pixel array (the cam_n_link Y direction) might map to either the CV image's row or column (usually row, though).
        </crs:purpose>
      <crs:authority>Pegasus DIT</crs:authority>
      <crs:origin>
          TBD:
            - Center of the aperture
            - "virtual" pinhole of the camera-lens system.
            - Principal Point, i.e. the point where the optical axis intersects the image sensor plane.
        </crs:origin>
      <crs:orientation>
          Z: Depth:
            The optical axis, pointing straight out of the lens, exactly perpendicular to the flat surface of the image sensor. Coinciding with the X direction of the corresponding Camera Link CRS.
          X: Right:
            The axis parallel to the image rows, pointing toward the right side when looking at the image on a display.
          Y: Down:
            The axis parallel to the image columns of the pixel array, pointing down when looking at the image on a display.
        </crs:orientation>
    </crs:description>
  </link>
  <joint name="cam_wide_cv_j" type="fixed">
    <parent link="cam_wide_link"/>
    <child link="cam_wide_cv_frame"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>
